{
  "version": 3,
  "configurePresets": [
    {
      "name": "ci",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCALE_SHIFT_ENABLE_ASAN": "ON",
        "SCALE_SHIFT_ENABLE_UBSAN": "ON",
        "SCALE_SHIFT_BUILD_TESTS": "ON",
        "SCALE_SHIFT_OPENMP": "ON"
      }
    },
    {
      "name": "release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SCALE_SHIFT_OPENMP": "ON",
        "SCALE_SHIFT_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "ci", "configurePreset": "ci" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true }
    }
  ]
}
