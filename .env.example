# Copy to .env (git-ignored) and fill in. Nothing here belongs in a script.

# Weights & Biases. Leave unset to disable tracking entirely.
WANDB_API_KEY=

# Root of the rendered Blender dataset (rgb/, depth/, mask/, ann/, Da2Finetune/).
DATA_ROOT=/path/to/Data/full_spur

# Refiner checkpoint used by the service and the benchmark harness.
SPUR_CKPT=/path/to/best_epoch_0023.pt

# JSONL of per-request input/prediction stats (no images). Unset to disable.
# SPUR_REQUEST_LOG=/tmp/spur_requests.jsonl

# Tracker JSONL (P6). Unset to disable.
# SPUR_TRACK_JSONL=/tmp/spur_track.jsonl

# Model/framework caches. Set inside the container so nothing writes to $HOME.
TORCH_HOME=/opt/cache/torch
HF_HOME=/opt/cache/hf
